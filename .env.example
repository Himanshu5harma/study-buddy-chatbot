# Copy this file to .env and fill in your key. Never commit .env.

# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Free models end in ":free"; see https://openrouter.ai/models?q=free
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct:free
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024

DATABASE_PATH=data/chat_history.db
MAX_HISTORY_TOKENS=3000
LOG_LEVEL=INFO
